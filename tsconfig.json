{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022"
  },
  "include": ["src/**/*.js"]
}
